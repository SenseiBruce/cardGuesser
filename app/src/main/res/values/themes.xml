<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.MagicHaptic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/antique_gold</item>
        <item name="colorOnPrimary">@color/obsidian_black</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/deep_velvet</item>
        <item name="colorOnSecondary">@color/antique_gold</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/obsidian_black</item>
        <item name="android:navigationBarColor">@color/obsidian_black</item>
        <item name="android:windowBackground">@color/obsidian_black</item>
        
        <!-- Surface and Text colors -->
        <item name="colorSurface">@color/obsidian_black</item>
        <item name="colorOnSurface">@color/antique_gold</item>
        <item name="colorSurfaceVariant">#1A1B1E</item>
        <item name="colorOnSurfaceVariant">@color/gold_glow</item>

        <!-- Tooltip/Snackbar style -->
        <item name="snackbarStyle">@style/Widget.MaterialComponents.Snackbar</item>
    </style>

    <style name="Theme.MagicHaptic.NoActionBar" parent="Theme.MagicHaptic">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>

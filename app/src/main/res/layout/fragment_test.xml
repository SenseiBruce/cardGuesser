<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_black">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTestMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOOLKIT"
                android:textColor="@color/antique_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Manual Lookup Section -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilManualPosition"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:hint="Position (1-52)"
                android:textColorHint="@color/gold_glow"
                app:boxStrokeColor="@color/antique_gold"
                app:hintTextColor="@color/antique_gold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTestMode">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etManualPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/magic_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnVibrateManual"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="VIBRATE"
                android:textColor="@color/antique_gold"
                app:layout_constraintBottom_toBottomOf="@id/tilManualPosition"
                app:layout_constraintStart_toEndOf="@id/tilManualPosition"
                app:layout_constraintTop_toTopOf="@id/tilManualPosition" />

            <TextView
                android:id="@+id/tvManualCardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Copy manual lookup"
                android:text="Result: --"
                android:textColor="@color/magic_white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tilManualPosition" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:dividerColor="@color/deep_velvet"
                app:layout_constraintTop_toBottomOf="@id/tvManualCardInfo" />

            <!-- Quick Test Grid -->
            <TextView
                android:id="@+id/tvQuickTestHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="── QUICK DRILLS ──"
                android:textColor="@color/antique_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider1" />

            <GridLayout
                android:id="@+id/cardGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:columnCount="4"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds"
                app:layout_constraintTop_toBottomOf="@id/tvQuickTestHeader" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/dividerDrill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:dividerColor="@color/deep_velvet"
                app:layout_constraintTop_toBottomOf="@id/cardGrid" />

            <TextView
                android:id="@+id/tvDrillHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="── IDENTIFICATION DRILL ──"
                android:textColor="@color/antique_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerDrill" />

            <TextView
                android:id="@+id/tvDrillStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Copy drill stats"
                android:text="Feel the pattern, then tap the card. Pocket practice without looking."
                android:textColor="@color/magic_white"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvDrillHeader" />

            <Button
                android:id="@+id/btnStartDrill"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PLAY PATTERN"
                android:textColor="@color/antique_gold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDrillStatus" />

            <LinearLayout
                android:id="@+id/drillOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/btnStartDrill">

                <Button
                    android:id="@+id/btnDrill1"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="—"
                    android:textColor="@color/antique_gold" />

                <Button
                    android:id="@+id/btnDrill2"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="—"
                    android:textColor="@color/antique_gold" />

                <Button
                    android:id="@+id/btnDrill3"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="—"
                    android:textColor="@color/antique_gold" />

                <Button
                    android:id="@+id/btnDrill4"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="—"
                    android:textColor="@color/antique_gold" />
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:dividerColor="@color/deep_velvet"
                app:layout_constraintTop_toBottomOf="@id/drillOptions" />

            <!-- Real-time Speech Log -->
            <TextView
                android:id="@+id/tvSpeechLogHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:text="── PERCEPTION LOG ──"
                android:textColor="@color/antique_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnClearSpeechLog"
                app:layout_constraintTop_toBottomOf="@id/divider2" />

            <Button
                android:id="@+id/btnCopySpeechLog"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/copy_speech_log"
                android:textColor="@color/antique_gold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSpeechLogHeader" />
                android:id="@+id/btnClearSpeechLog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_speech_log"
                android:textColor="@color/antique_gold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSpeechLogHeader"
                app:layout_constraintBottom_toBottomOf="@id/tvSpeechLogHeader" />

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSpeechLog"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                app:layout_constraintTop_toBottomOf="@id/btnCopySpeechLog" />
                app:layout_constraintTop_toBottomOf="@id/tvSpeechLogHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

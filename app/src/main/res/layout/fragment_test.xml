<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTestMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TEST MODE"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etManualPosition"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Pos (1-52)"
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTestMode" />

    <Button
        android:id="@+id/btnVibrateManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="VIBRATE"
        app:layout_constraintBottom_toBottomOf="@id/etManualPosition"
        app:layout_constraintStart_toEndOf="@id/etManualPosition"
        app:layout_constraintTop_toTopOf="@id/etManualPosition" />

    <TextView
        android:id="@+id/tvManualCardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Card Details: -"
        app:layout_constraintTop_toBottomOf="@id/etManualPosition" />

    <TextView
        android:id="@+id/tvQuickTestHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="── Quick Test ──"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvManualCardInfo" />

    <!-- GridLayout for quick test cards -->
    <GridLayout
        android:id="@+id/cardGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="4"
        android:rowCount="2"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/tvQuickTestHeader">
        <!-- Buttons will be added programmatically or as static items -->
    </GridLayout>

    <TextView
        android:id="@+id/tvSpeechLogHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="── Speech Log ──"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardGrid" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSpeechLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSpeechLogHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>

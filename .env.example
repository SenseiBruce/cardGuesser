# Example environment / local overrides for contributors.
# Copy via: ./scripts/setup.sh   (or: cp .env.example .env)

# Path to Android SDK (also set via local.properties sdk.dir=...)
ANDROID_SDK_ROOT=/path/to/Android/Sdk
ANDROID_HOME=/path/to/Android/Sdk

# Optional: JDK home when multiple JDKs are installed
# JAVA_HOME=/path/to/jdk-17

# Optional release signing (unused in debug builds; surface for CI/secrets wiring)
# KEYSTORE_PATH=/path/to/release.keystore
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=

# Optional crash reporting backend (CrashReporter uses NoOp unless configured)
# SENTRY_DSN=
# FIREBASE_CRASHLYTICS_ENABLED=false

# Vosk offline model is NOT an env var — place files under:
#   app/src/main/assets/model-en-us/
# See README "Speech model asset" section.

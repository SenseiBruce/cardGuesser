# Example environment / local overrides for contributors.
# Copy to `.env` if your tooling expects it (Android primarily uses local.properties).

# Path to Android SDK (also set via local.properties sdk.dir=...)
ANDROID_SDK_ROOT=/path/to/Android/Sdk
ANDROID_HOME=/path/to/Android/Sdk

# Optional: JDK home when multiple JDKs are installed
# JAVA_HOME=/path/to/jdk-17
